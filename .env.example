# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 key (Google Cloud Console, free)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=waynashville

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Random string; Vercel sends it as Authorization: Bearer <CRON_SECRET> on cron calls
CRON_SECRET=

# youtube-transcript.io Basic API token (from their profile page). Required in
# production: YouTube's innertube API returns LOGIN_REQUIRED from datacenter IPs,
# so lib/transcript.js falls back to this. Without it, cron ingestion fails.
YT_TRANSCRIPT_IO_TOKEN=
